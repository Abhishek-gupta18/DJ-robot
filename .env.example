# Spotify API Credentials (get from https://developer.spotify.com/dashboard)
# Create a new app, then copy Client ID and Client Secret here
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_client_secret_here

# YouTube Data API v3 Key (get from https://console.cloud.google.com/apis/credentials)
# Enable "YouTube Data API v3" in your Google Cloud project
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here